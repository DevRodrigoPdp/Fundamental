---
import SeoHead from '@components/layout/SeoHead.astro';
import type { PageSeo } from '@app-types/seo';
import '@styles/global.css';

type Props = PageSeo;
---
<!doctype html>
<html lang="es">
  <head>
    <SeoHead {...Astro.props} />
    <style>
      * { scrollbar-width: none; }
      *::-webkit-scrollbar { display: none; }
      @view-transition {
        navigation: auto;
      }
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 0.25s;
      }
    </style>
  </head>
  <body class="antialiased text-[#111111]">
    <slot />

    <script>import '@scripts/shared/reveal';</script>
  </body>
</html>
