---
import Layout from '@layouts/BaseLayout.astro';
import Nav from '@components/layout/Nav/Nav.astro';
import BackToTop from '@components/ui/BackToTop.astro';
import SimpleFooter from '@components/layout/Footer/SimpleFooter.astro';
import AboutHero from '@components/features/about/AboutHero.astro';
import AboutIntro from '@components/features/about/AboutIntro.astro';
import AboutBrands from '@components/features/about/AboutBrands.astro';
import AboutCta from '@components/features/about/AboutCta.astro';
import AboutAudience from '@components/features/about/AboutAudience.astro';
import '@styles/global.css';
import { PAGE_SEO } from '@config/seo';
---

<Layout {...PAGE_SEO.about}>
  <Nav active="nosotros" />
  <AboutHero />
  <AboutIntro />
  <AboutBrands />
  <AboutCta />
  <AboutAudience />
  <SimpleFooter title="Fundamental" class="border-t border-gray-200 px-5 py-10 md:px-16" />
  <BackToTop />
</Layout>
