---
import '../../styles/global.css';

export const prerender = false;

const error = Astro.url.searchParams.get('error') === '1';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin | Fundamental Bike Parts</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      body { font-family: 'Inter', sans-serif; }
      input:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(196, 160, 114, 0.25);
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#1A100C] flex items-center justify-center px-5 relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(196,160,114,0.14),transparent_45%)]"></div>

    <form id="login-form" method="POST" action="/api/admin/login" class="relative z-10 w-full max-w-sm bg-[#141210] border border-white/10 p-9 shadow-[0_30px_80px_rgba(0,0,0,0.45)]">
      <img src="/logo_blanco_t3r.png" alt="T3R" class="h-7 w-auto mb-8 opacity-90" />

      <h1 class="text-white text-xl font-bold mb-1">Panel de administración</h1>
      <p class="text-white/40 text-sm mb-7">Gestión de productos T3R</p>

      {error && (
        <p class="mb-5 border border-red-400/30 bg-red-400/10 px-3 py-2 text-sm text-red-300">
          Contraseña incorrecta.
        </p>
      )}

      <label class="block mb-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-white/40">Contraseña</label>
      <input
        type="password"
        name="password"
        required
        autofocus
        class="w-full mb-7 border border-white/15 bg-white/5 px-4 py-3 text-white outline-none transition-colors focus:border-[#C4A072]"
      />

      <button type="submit" id="login-submit" class="w-full bg-[#C4A072] text-[#1A100C] font-bold py-3.5 uppercase tracking-[0.12em] text-sm hover:bg-[#D4B280] transition-colors cursor-pointer disabled:opacity-60">
        Entrar
      </button>

      <a href="/" class="mt-5 block text-center text-xs font-semibold uppercase tracking-[0.12em] text-white/40 hover:text-white transition-colors">
        ← Volver a la web
      </a>
    </form>

    <script src="../../scripts/admin/login.ts"></script>
  </body>
</html>
