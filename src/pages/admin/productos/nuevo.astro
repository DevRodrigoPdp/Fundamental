---
export const prerender = false;

import '../../../styles/global.css';
import { getSubcategoriasAgrupadas } from '../../../data/product-taxonomy';
import { ESTADOS_STOCK } from '../../../data/estado-stock';
import { ArrowLeft, Plus, X } from 'lucide-astro';

const grupos = getSubcategoriasAgrupadas();
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Nuevo producto | Admin T3R</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      body { font-family: 'Inter', sans-serif; }
      input:focus, select:focus, textarea:focus, button:focus-visible, a:focus-visible {
        outline: none;
        box-shadow: 0 0 0 3px rgba(196, 160, 114, 0.3);
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#faf9f7] text-[#111]">
    <header class="flex flex-wrap items-center gap-3 border-b border-gray-200 bg-white px-4 py-4 sm:px-6">
      <a href="/admin" class="inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-[0.1em] text-gray-400 hover:text-black transition-colors">
        <ArrowLeft size={14} stroke-width={2} />
        Panel
      </a>
      <div class="h-4 w-px bg-gray-200"></div>
      <h1 class="text-sm font-bold uppercase tracking-[0.1em] text-gray-500">Nuevo producto</h1>
    </header>

    <main class="w-full px-4 py-10 sm:px-6 lg:px-10 xl:px-16">
      <div class="mx-auto max-w-2xl">
      <div class="mb-8 border border-[#C4A072]/30 bg-[#C4A072]/10 px-5 py-4">
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.15em] text-[#8a6a44]">Cómo crear un producto</p>
        <ol class="list-decimal space-y-1 pl-5 text-sm text-[#5c4a30]">
          <li>Rellena los campos marcados con <strong>*</strong> (Nombre, Tipo de producto). El resto es opcional, puedes completarlo luego.</li>
          <li>El <strong>SKU (referencia) se genera solo</strong>, no hace falta escribirlo.</li>
          <li>Pulsa <strong>"Crear producto"</strong> al final del formulario.</li>
          <li>Se abrirá automáticamente la página de edición, donde podrás <strong>subir las fotos</strong>.</li>
          <li>Cada vez que guardes algo, la web se publica sola (tarda 1-2 minutos en verse).</li>
        </ol>
      </div>

      <form id="form" class="space-y-8">
        <p id="error" class="hidden border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-600"></p>

        <section class="space-y-4">
          <h2 class="text-xs font-bold uppercase tracking-[0.15em] text-gray-400 border-b border-gray-200 pb-2">Identificación</h2>
          <div>
            <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Nombre *</label>
            <input name="nombre" required maxlength="80" class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black" placeholder="Ej: Pastillas de freno SRAM Guide" />
            <p class="mt-1 text-xs text-gray-400">Nombre corto (máx. 80 caracteres). La lista de modelos compatibles va en "Descripción corta", no aquí.</p>
          </div>
          <div>
            <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Tipo de producto *</label>
            <select id="taxonomy" required class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black">
              <option value="">Selecciona...</option>
              {grupos.map((grupo) => (
                <optgroup label={grupo.filtro}>
                  {grupo.opciones.map((op) => (
                    <option value={`${op.categoria}|${op.subcategoria}`}>{op.subcategoria}</option>
                  ))}
                </optgroup>
              ))}
              <option value="otra">Otra (no está en la lista)</option>
            </select>
            <p class="mt-1 text-xs text-gray-400">Determina en qué filtro del catálogo aparecerá el producto.</p>
          </div>
          <div id="otra-categoria" class="hidden space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Categoría *</label>
                <input name="categoria" class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black" placeholder="Ej: Frenos" />
              </div>
              <div>
                <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Subcategoría</label>
                <input name="subcategoria" class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black" placeholder="Ej: Pastillas de freno" />
              </div>
            </div>
            <div>
              <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">SKU *</label>
              <input name="sku" class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black" placeholder="T3R-XXX-000" />
              <p class="mt-1 text-xs text-gray-400">Para tipos de la lista se genera solo. Como es "otro" tipo, indícalo tú.</p>
            </div>
          </div>
        </section>

        <section class="space-y-4">
          <h2 class="text-xs font-bold uppercase tracking-[0.15em] text-gray-400 border-b border-gray-200 pb-2">Descripción</h2>
          <div>
            <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Descripción corta</label>
            <input name="descripcion_corta" class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black" placeholder="Una frase breve, se usa en las tarjetas del catálogo" />
          </div>
          <div>
            <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Descripción completa</label>
            <textarea name="descripcion" rows="4" class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black" placeholder="Se muestra en la ficha de producto"></textarea>
          </div>
        </section>

        <section class="space-y-4">
          <h2 class="text-xs font-bold uppercase tracking-[0.15em] text-gray-400 border-b border-gray-200 pb-2">Especificaciones</h2>
          <p class="text-xs text-gray-400">Campos libres tipo ficha técnica (ej: "Compuesto" → "Semi-metálico"). Opcional.</p>
          <div id="specs-list" class="space-y-2"></div>
          <button type="button" id="specs-add" class="inline-flex items-center gap-1 text-xs font-semibold uppercase text-[#6B8CAE] hover:underline cursor-pointer">
            <Plus size={12} stroke-width={2.5} />
            Añadir especificación
          </button>
        </section>

        <section class="space-y-4">
          <h2 class="text-xs font-bold uppercase tracking-[0.15em] text-gray-400 border-b border-gray-200 pb-2">Inventario</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Stock</label>
              <input name="stock" type="number" class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black" />
            </div>
            <div>
              <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Precio</label>
              <input name="precio" type="number" step="0.01" class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black" />
            </div>
          </div>
          <div>
            <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Estado del stock</label>
            <select name="estado_stock" class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black">
              {Object.entries(ESTADOS_STOCK).map(([value, info]) => (
                <option value={value} selected={value === 'disponible'}>{info.label}</option>
              ))}
            </select>
          </div>
          <label class="flex items-center gap-2 text-sm">
            <input name="activo" type="checkbox" checked class="h-4 w-4 accent-[#C4A072]" />
            Activo (visible en el catálogo público)
          </label>
        </section>

        <button type="submit" id="submit-btn" class="bg-black text-white text-xs font-bold uppercase tracking-[0.1em] px-6 py-3.5 hover:bg-[#1A100C] transition-colors cursor-pointer disabled:opacity-50">
          Crear producto
        </button>
      </form>
      </div>
    </main>

    <script src="../../../scripts/admin/producto-nuevo.ts"></script>
  </body>
</html>
