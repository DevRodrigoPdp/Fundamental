---
export const prerender = false;

import '../../../styles/global.css';
import { supabaseAdmin } from '../../../lib/supabaseAdmin';
import { getSubcategoriasAgrupadas, SUBCATEGORIAS } from '../../../data/product-taxonomy';
import { ESTADOS_STOCK } from '../../../data/estado-stock';
import { cld, cldDownload } from '../../../lib/cloudinaryUrl';
import { ArrowLeft, ArrowUp, ArrowDown, Trash2, Plus, UploadCloud, Download } from 'lucide-astro';

const { sku } = Astro.params;

const { data: product } = await supabaseAdmin
  .from('productos_t3r')
  .select('*')
  .eq('sku', sku)
  .single();

if (!product) {
  return Astro.redirect('/admin');
}

const { data: images } = await supabaseAdmin
  .from('imagenes_productos')
  .select('*')
  .eq('producto_sku', sku)
  .order('orden', { ascending: true });

const specEntries = Object.entries(product.especificaciones ?? {});
const grupos = getSubcategoriasAgrupadas();
const matchedTaxonomy = SUBCATEGORIAS.find((s) => s.subcategoria === product.subcategoria);
const currentTaxonomyValue = matchedTaxonomy ? `${matchedTaxonomy.categoria}|${matchedTaxonomy.subcategoria}` : 'otra';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Editar {product.nombre} | Admin T3R</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      body { font-family: 'Inter', sans-serif; }
      input:focus, select:focus, textarea:focus, button:focus-visible, a:focus-visible {
        outline: none;
        box-shadow: 0 0 0 3px rgba(196, 160, 114, 0.3);
      }
      .toast {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 100;
        padding: 0.75rem 1.1rem;
        font-size: 0.8125rem;
        font-weight: 500;
        box-shadow: 0 12px 32px rgba(0,0,0,0.14);
        transition: opacity 0.3s ease, transform 0.3s ease;
        max-width: 320px;
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#faf9f7] text-[#111]">
    <header class="flex flex-wrap items-center gap-3 border-b border-gray-200 bg-white px-4 py-4 sm:px-6">
      <a href="/admin" class="inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-[0.1em] text-gray-400 hover:text-black transition-colors">
        <ArrowLeft size={14} stroke-width={2} />
        Panel
      </a>
      <div class="h-4 w-px bg-gray-200"></div>
      <h1 class="break-words text-sm font-bold">{product.nombre} <span class="text-gray-400 font-normal">· {product.sku}</span></h1>
    </header>

    <main class="w-full px-4 py-10 grid gap-10 lg:grid-cols-2 sm:px-6 lg:px-10 xl:px-16">
      <section>
        <form id="form" data-sku={product.sku} class="space-y-8">
          <p id="error" class="hidden border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-600"></p>
          <p id="saved" class="hidden border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-700"></p>

          <section class="space-y-4">
            <h2 class="text-xs font-bold uppercase tracking-[0.15em] text-gray-400 border-b border-gray-200 pb-2">Identificación</h2>
            <div>
              <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Nombre *</label>
              <input name="nombre" required maxlength="80" value={product.nombre} class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black" />
              <p class="mt-1 text-xs text-gray-400">Nombre corto (máx. 80 caracteres). La lista de modelos compatibles va en "Descripción corta", no aquí.</p>
            </div>
            <div>
              <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Tipo de producto *</label>
              <select id="taxonomy" required class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black">
                {grupos.map((grupo) => (
                  <optgroup label={grupo.filtro}>
                    {grupo.opciones.map((op) => (
                      <option value={`${op.categoria}|${op.subcategoria}`} selected={currentTaxonomyValue === `${op.categoria}|${op.subcategoria}`}>{op.subcategoria}</option>
                    ))}
                  </optgroup>
                ))}
                <option value="otra" selected={currentTaxonomyValue === 'otra'}>Otra (no está en la lista)</option>
              </select>
              <p class="mt-1 text-xs text-gray-400">Determina en qué filtro del catálogo aparecerá el producto.</p>
            </div>
            <div id="otra-categoria" class:list={['grid grid-cols-1 sm:grid-cols-2 gap-4', currentTaxonomyValue !== 'otra' && 'hidden']}>
              <div>
                <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Categoría *</label>
                <input name="categoria" value={product.categoria} class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black" />
              </div>
              <div>
                <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Subcategoría</label>
                <input name="subcategoria" value={product.subcategoria ?? ''} class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black" />
              </div>
            </div>
          </section>

          <section class="space-y-4">
            <h2 class="text-xs font-bold uppercase tracking-[0.15em] text-gray-400 border-b border-gray-200 pb-2">Descripción</h2>
            <div>
              <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Descripción corta</label>
              <input name="descripcion_corta" value={product.descripcion_corta ?? ''} class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black" />
            </div>
            <div>
              <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Descripción completa</label>
              <textarea name="descripcion" rows="4" class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black">{product.descripcion ?? ''}</textarea>
            </div>
          </section>

          <section class="space-y-4">
            <h2 class="text-xs font-bold uppercase tracking-[0.15em] text-gray-400 border-b border-gray-200 pb-2">Especificaciones</h2>
            <p class="text-xs text-gray-400">Campos libres tipo ficha técnica (ej: "Compuesto" → "Semi-metálico").</p>
            <div id="specs-list" class="space-y-2">
              {specEntries.map(([key, value]) => (
                <div class="flex gap-2">
                  <input placeholder="Campo" value={key} data-spec-key class="w-1/3 border border-gray-300 bg-white px-3 py-2 text-sm outline-none focus:border-black" />
                  <input placeholder="Valor" value={String(value)} data-spec-value class="flex-1 border border-gray-300 bg-white px-3 py-2 text-sm outline-none focus:border-black" />
                  <button type="button" data-spec-remove class="px-2 text-gray-400 hover:text-red-500 cursor-pointer">✕</button>
                </div>
              ))}
            </div>
            <button type="button" id="specs-add" class="inline-flex items-center gap-1 text-xs font-semibold uppercase text-[#6B8CAE] hover:underline cursor-pointer">
              <Plus size={12} stroke-width={2.5} />
              Añadir especificación
            </button>
          </section>

          <section class="space-y-4">
            <h2 class="text-xs font-bold uppercase tracking-[0.15em] text-gray-400 border-b border-gray-200 pb-2">Inventario</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Stock</label>
                <input name="stock" type="number" value={product.stock ?? ''} class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black" />
              </div>
              <div>
                <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Precio</label>
                <input name="precio" type="number" step="0.01" value={product.precio ?? ''} class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black" />
              </div>
            </div>
            <div>
              <label class="block mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Estado del stock</label>
              <select name="estado_stock" class="w-full border border-gray-300 bg-white px-3 py-2.5 outline-none focus:border-black">
                {Object.entries(ESTADOS_STOCK).map(([value, info]) => (
                  <option value={value} selected={product.estado_stock === value}>{info.label}</option>
                ))}
              </select>
            </div>
            <label class="flex items-center gap-2 text-sm">
              <input name="activo" type="checkbox" checked={product.activo} class="h-4 w-4 accent-[#C4A072]" />
              Activo (visible en el catálogo público)
            </label>
          </section>

          <div class="flex items-center gap-4">
            <button type="submit" id="submit-btn" class="bg-black text-white text-xs font-bold uppercase tracking-[0.1em] px-6 py-3.5 hover:bg-[#1A100C] transition-colors cursor-pointer disabled:opacity-50">
              Guardar cambios
            </button>
            <button type="button" id="delete-btn" class="inline-flex items-center gap-1 text-xs font-semibold uppercase text-red-500 hover:underline cursor-pointer">
              <Trash2 size={13} stroke-width={2} />
              Borrar producto
            </button>
          </div>
        </form>
      </section>

      <section>
        <h2 class="mb-1 text-xs font-bold uppercase tracking-[0.15em] text-gray-400 border-b border-gray-200 pb-2">Fotos</h2>
        <p class="mb-4 mt-2 text-xs text-gray-400">La primera foto es la principal (portada). Usa las flechas para reordenar.</p>
        <div id="gallery" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5 mb-6">
          {(images ?? []).map((img: any, i: number) => (
            <div class="relative border border-gray-200 bg-white p-3" data-image={img.id}>
              {i === 0 && <span data-portada-badge class="absolute left-3 top-3 z-10 bg-[#C4A072] text-[#1A100C] text-[10px] font-bold px-1.5 py-0.5 uppercase">Portada</span>}
              <img src={cld(img.url, { width: 500 })} alt="" loading="lazy" decoding="async" class="aspect-square w-full object-contain" />
              <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
                <div class="flex gap-3">
                  <button type="button" class="text-gray-400 hover:text-black cursor-pointer" data-move={img.id} data-direction="up" title="Subir">
                    <ArrowUp size={14} stroke-width={2} />
                  </button>
                  <button type="button" class="text-gray-400 hover:text-black cursor-pointer" data-move={img.id} data-direction="down" title="Bajar">
                    <ArrowDown size={14} stroke-width={2} />
                  </button>
                </div>
                <div class="flex items-center gap-4">
                  <a href={cldDownload(img.url)} download class="inline-flex items-center gap-1 text-xs font-semibold uppercase text-[#6B8CAE] hover:underline">
                    <Download size={12} stroke-width={2} />
                    Descargar
                  </a>
                  <button type="button" class="inline-flex items-center gap-1 text-xs font-semibold uppercase text-red-500 hover:underline cursor-pointer" data-delete-image={img.id}>
                    <Trash2 size={12} stroke-width={2} />
                    Borrar
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
        {(images ?? []).length === 0 && (
          <p id="gallery-empty" class="mb-6 border border-dashed border-gray-300 px-4 py-8 text-center text-sm text-gray-400">Sin fotos todavía. Sube la primera abajo.</p>
        )}
        <label class="mb-1 flex items-center gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500">
          <UploadCloud size={13} stroke-width={2} />
          Subir foto nueva
        </label>
        <input id="file-input" type="file" accept="image/*" class="w-full border border-gray-300 bg-white px-3 py-2.5" />
        <p id="upload-status" class="mt-2 hidden text-sm text-gray-500"></p>
      </section>
    </main>

    <script src="../../../scripts/admin/producto-editar.ts"></script>
  </body>
</html>
