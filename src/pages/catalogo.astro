---
import Layout from '@layouts/BaseLayout.astro';
import Nav from '@components/layout/Nav/Nav.astro';
import BackToTop from '@components/ui/BackToTop.astro';
import SimpleFooter from '@components/layout/Footer/SimpleFooter.astro';
import CatalogHero from '@components/features/catalog/CatalogHero.astro';
import CatalogGrid from '@components/features/catalog/CatalogGrid.astro';
import { PAGE_SEO } from '@config/seo';
import { getCatalog } from '@lib/services/catalog';

const catalog = await getCatalog();
---

<Layout {...PAGE_SEO.catalog}>
  <Nav />
  <BackToTop />
  <CatalogHero />
  <CatalogGrid products={catalog} />
  <SimpleFooter title="T3R × Fundamental" />

  <script>import '@scripts/catalog/catalog';</script>
</Layout>
