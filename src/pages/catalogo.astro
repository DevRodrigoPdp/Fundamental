---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import BackToTop from '../components/BackToTop.astro';
import '../styles/global.css';
import { supabase } from '../lib/supabase';
import { SITE } from '../config/site';
import { getCatalogFilters, DISK_FAMILIES } from '../data/product-taxonomy';
import { cld } from '../lib/cloudinaryUrl';

const CONTACT_EMAIL = 'info@fundamentalbikeparts.com';

const { data: products, error } = await supabase
  .from('productos_t3r')
  .select('*')
  .eq('activo', true)
  .order('categoria', { ascending: true });

if (error) console.error('Supabase productos error:', error.message);

const skus = (products ?? []).map((p: any) => p.sku);

const { data: imagenes } = skus.length > 0
  ? await supabase
      .from('imagenes_productos')
      .select('producto_sku, url, orden')
      .in('producto_sku', skus)
      .eq('orden', 1)
  : { data: [] };

const imgMap: Record<string, string> = {};
(imagenes ?? []).forEach((i: any) => {
  if (i.url) imgMap[i.producto_sku] = i.url;
});

const catalogoBase = (products ?? []).map((p: any) => ({
  nombre: p.nombre,
  categoria: p.categoria,
  subcategoria: p.subcategoria,
  descripcion: p.descripcion_corta,
  sku: p.sku,
  imagen: imgMap[p.sku] ?? null,
  cantidadStock: p.stock ?? null,
}));

function stockLabel(quantity: number | null) {
  if (quantity === 0) return 'Agotado';
  if (quantity !== null && quantity <= 10) return 'Pocas unidades en stock';
  return null;
}

const diskFamilies = DISK_FAMILIES;

const groupedPrefixes = new Set<string>();
const catalogo = catalogoBase.flatMap((item: any) => {
  const family = diskFamilies.find(({ prefix }) => item.sku.startsWith(prefix));
  if (!family) return [item];
  if (groupedPrefixes.has(family.prefix)) return [];
  groupedPrefixes.add(family.prefix);

  const variants = catalogoBase
    .filter((candidate: any) => candidate.sku.startsWith(family.prefix))
    .sort((a: any, b: any) => Number(a.sku.match(/(\d+)$/)?.[1]) - Number(b.sku.match(/(\d+)$/)?.[1]));
  const representative = variants.find((variant: any) => variant.sku.endsWith('-140')) ?? variants[0];
  const sizes = variants.map((variant: any) => variant.sku.match(/(\d+)$/)?.[1]).filter(Boolean);

  return [{
    ...representative,
    nombre: family.nombre,
    descripcion: `Disponible en ${sizes.join(', ')} mm. Selecciona la medida dentro del producto.`,
    refLabel: `${sizes.join(' · ')} mm`,
    searchSku: variants.map((variant: any) => variant.sku).join(' '),
  }];
});

const sortedCatalog = [...catalogo].sort((a: any, b: any) =>
  a.nombre.localeCompare(b.nombre, 'es', { sensitivity: 'base' })
);

const FILTERS = getCatalogFilters();
---

<Layout
  title="Catálogo T3R | Componentes para bicicleta"
  description="Consulta el catálogo T3R de componentes para bicicleta: frenos, pedales, pedalieres, puños, válvulas, cables, bolsas y accesorios."
  image="https://res.cloudinary.com/dxent4dkd/image/upload/v1783166514/catalogo_t3r/combos/combos_3.jpg"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Catálogo T3R',
    description: 'Catálogo de recambios y componentes T3R para bicicletas.',
    url: `${SITE.url}/catalogo`,
    isPartOf: { '@id': `${SITE.url}/#website` },
  }}
>

  <Nav />
  <BackToTop />

  <!-- HERO + BUSCADOR -->
  <section class="px-5 md:px-16 pt-32 md:pt-36 pb-16">
    <p data-reveal class="text-sm text-[#6B8CAE] tracking-[0.3em] uppercase mb-6">Marca · T3R</p>
    <h1 data-reveal data-delay="1" class="text-[40px] md:text-[64px] font-bold leading-tight mb-6">
      Catálogo T3R.
    </h1>
    <p data-reveal data-delay="2" class="text-lg text-[#6B8CAE] max-w-lg leading-relaxed mb-10">
      Servimos a tiendas y clientes finales.
    </p>

    <div data-reveal data-delay="3" class="relative max-w-2xl">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M19 11a8 8 0 11-16 0 8 8 0 0116 0z" />
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder="Buscar por nombre, categoría o referencia..."
          class="w-full border border-gray-300 pl-12 pr-12 py-3.5 text-base outline-none focus:border-black transition-colors [&::-webkit-search-cancel-button]:hidden"
          autocomplete="off"
          aria-label="Buscar en el catálogo"
          aria-controls="product-grid"
        />
        <button id="search-clear" type="button" class="hidden absolute right-3 top-1/2 -translate-y-1/2 p-2 text-gray-400 hover:text-black transition-colors" aria-label="Limpiar búsqueda">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="m6 6 12 12M18 6 6 18"/></svg>
        </button>
    </div>
    <div class="mt-4 flex min-h-6 flex-wrap items-center gap-x-5 gap-y-2">
      <p id="search-status" class="text-xs text-gray-400" role="status" aria-live="polite"></p>
      <button id="mobile-filter-toggle" type="button" class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] lg:hidden" aria-expanded="false" aria-controls="catalog-filters">
        Filtros
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" d="M4 7h16M7 12h10M10 17h4"/></svg>
      </button>
      <button id="filters-clear" type="button" style="display: none;" class="inline-flex items-center gap-1 rounded-full border border-gray-300 px-2.5 py-1 text-[11px] font-medium text-gray-600 transition-colors hover:border-black hover:bg-black hover:text-white">
        <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="m6 6 12 12M18 6 6 18"/></svg>
        Limpiar filtros
      </button>
    </div>
  </section>

  <!-- GRID PRODUCTOS -->
  <section class="px-5 md:px-16 pb-32">
    {catalogo.length > 0 ? (
      <>
        <div class="grid items-start gap-8 lg:grid-cols-[260px_minmax(0,1fr)] xl:grid-cols-[290px_minmax(0,1fr)]">
          <aside id="catalog-filters" class="hidden border border-gray-200 bg-[#faf9f7] lg:sticky lg:top-28 lg:block">
            <div class="flex items-center justify-between border-b border-gray-200 px-5 py-4">
              <div>
                <p class="text-[9px] uppercase tracking-[0.26em] text-gray-400">Catálogo T3R</p>
                <h2 class="mt-1 text-base font-bold">Filtrar productos</h2>
              </div>
              <button id="sidebar-clear" type="button" style="display: none;" class="inline-flex items-center gap-1 rounded-full border border-gray-300 px-2 py-0.5 text-[10px] font-medium text-gray-500 transition-colors hover:border-black hover:bg-black hover:text-white">
                <svg class="h-2 w-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" d="m6 6 12 12M18 6 6 18"/></svg>
                Limpiar
              </button>
            </div>

            <div class="p-5">
              <p class="mb-3 text-[10px] font-semibold uppercase tracking-[0.2em] text-gray-400">Categorías</p>
              <div class="flex flex-wrap gap-2 lg:flex-col lg:gap-1">
                <button type="button" data-category-filter="" class="filter-choice is-active">Catálogo completo</button>
                {FILTERS.map((filter) => (
                  <button type="button" data-category-filter={filter.subcategorias.join('|')} class="filter-choice">{filter.label}</button>
                ))}
              </div>
            </div>
          </aside>

          <div id="product-grid" class="grid grid-cols-2 xl:grid-cols-3 gap-3 bg-white">
          {sortedCatalog.map((p: any, i: number) => (
            <div
              data-product-card
              data-search={`${p.nombre} ${p.categoria} ${p.subcategoria ?? ''} ${p.sku}`.toLowerCase()}
              data-name={p.nombre}
              data-category={p.categoria}
              data-subcategory={p.subcategoria ?? ''}
              data-sku={p.searchSku ?? p.sku}
              data-product-id={p.sku}
              data-reveal data-delay={String(i % 4)}
              class="group flex flex-col border border-gray-200 bg-white transition-[border-color,box-shadow] duration-300 hover:border-gray-400 hover:shadow-[0_12px_34px_rgba(0,0,0,0.06)]"
            >
              <a href={`/catalogo/${p.sku}`} class="block cursor-pointer">
                <div class="relative overflow-hidden bg-white aspect-[4/3]">
                  {p.imagen ? (
                    <img
                      src={cld(p.imagen, { width: 500 })}
                      alt={p.nombre}
                      class="absolute inset-0 h-full w-full object-contain p-4 sm:p-5 transition-transform duration-500 group-hover:scale-[1.025]"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-white text-gray-300">
                      <img src="/logo_t3r.png" alt="T3R" class="w-20 opacity-25 grayscale" loading="lazy" />
                      <p class="text-[10px] tracking-[0.25em] uppercase text-gray-300">Foto próximamente</p>
                    </div>
                  )}
                </div>
                <div class="px-5 pt-5">
                  <p class="mb-2 text-[9px] uppercase tracking-[0.22em] text-gray-400">{p.subcategoria ?? p.categoria}</p>
                  <h3 class="mb-2 line-clamp-2 break-words text-[15px] font-bold leading-snug transition-colors group-hover:text-[#6B8CAE] sm:text-base">{p.nombre}</h3>
                  {p.descripcion && (
                    <p class="mb-4 line-clamp-2 text-xs leading-relaxed text-gray-500 sm:text-sm">{p.descripcion}</p>
                  )}
                  {stockLabel(p.cantidadStock) && (
                    <p class:list={[
                      'mb-5 text-xs font-semibold uppercase tracking-[0.12em]',
                      p.cantidadStock === 0 ? 'text-red-600' : 'text-amber-700',
                    ]}>
                      {stockLabel(p.cantidadStock)}
                    </p>
                  )}
                </div>
              </a>
              <div class="flex flex-1 flex-col px-5 pb-5">
                <div class="mt-auto flex flex-col items-start gap-3 border-t border-gray-100 pt-4 xl:flex-row xl:items-center xl:justify-between">
                  <div class="min-w-0">
                    <p class="truncate text-[11px] text-gray-400">{p.refLabel ?? p.sku}</p>
                    <p class="text-[11px] text-gray-400">Consulta disponibilidad</p>
                  </div>
                  <a
                    href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('Solicitud T3R — ' + p.nombre)}&body=${encodeURIComponent(`Hola,\n\nMe interesa el siguiente producto T3R:\n\nProducto: ${p.nombre}\nReferencia (SKU): ${p.sku}\nCategoría: ${p.categoria}${p.subcategoria ? ' / ' + p.subcategoria : ''}\n\nPor favor, indícame disponibilidad y precio.\n\nGracias.`)}`}
                    class="inline-flex shrink-0 cursor-pointer items-center gap-1 text-xs font-medium"
                  >
                    Solicitar
                    <span class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
                  </a>
                </div>
              </div>
            </div>
          ))}
          </div>
        </div>
        <p id="empty-state" class="hidden text-center text-gray-400 text-base py-20">
          No hay referencias que coincidan con tu búsqueda.
        </p>
      </>
    ) : (
      <p class="text-gray-400 text-base">Catálogo en preparación — vuelve pronto.</p>
    )}
  </section>

  <style>
    .filter-choice {
      width: 100%;
      border: 1px solid transparent;
      padding: 0.6rem 0.75rem;
      text-align: left;
      font-size: 0.78rem;
      color: rgb(75 85 99);
      transition: 180ms ease;
    }

    .filter-choice:hover,
    .filter-choice.is-active {
      border-color: rgb(17 17 17 / 0.12);
      background: white;
      color: #111;
    }

    .filter-choice.is-active {
      font-weight: 650;
      box-shadow: inset 3px 0 #111;
    }

    @media (max-width: 1023px) {
      #catalog-filters {
        margin-bottom: 1.5rem;
      }

      #catalog-filters.is-open {
        display: block;
      }

      .filter-choice {
        width: auto;
      }
    }
  </style>

  <!-- FOOTER -->
  <footer class="border-t border-gray-100 px-5 md:px-16 py-10 flex flex-col md:flex-row items-center md:items-start justify-between gap-4 text-center md:text-left">
    <div>
      <p class="text-base font-bold mb-2">T3R × Fundamental</p>
      <p class="text-sm text-gray-400 max-w-[240px] leading-relaxed">
        Distribuidora de componentes profesionales para ciclismo. Madrid, España.
      </p>
    </div>
    <div class="flex items-center gap-4 text-gray-400">
      <a href="https://www.instagram.com/fundamental_bike_parts?igsh=OWtqdjN6MXdrcDdl" target="_blank" rel="noopener noreferrer" aria-label="Instagram de Fundamental" class="transition-colors hover:text-[#6B8CAE]">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".75" fill="currentColor" stroke="none"/></svg>
      </a>
      <p class="text-sm">© 2026 FUNDAMENTAL</p>
    </div>
  </footer>

  <script src="../scripts/catalogo.ts"></script>

</Layout>
