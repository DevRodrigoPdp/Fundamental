---
import Layout from '@layouts/BaseLayout.astro';
import Nav from '@components/layout/Nav/Nav.astro';
import TransferHero from '@components/features/brand/transfer/TransferHero.astro';
import TransferIntro from '@components/features/brand/transfer/TransferIntro.astro';
import TransferProducts from '@components/features/brand/transfer/TransferProducts.astro';
import TransferGeometry from '@components/features/brand/transfer/TransferGeometry.astro';
import TransferCta from '@components/features/brand/transfer/TransferCta.astro';
import TransferFooter from '@components/features/brand/transfer/TransferFooter.astro';
import { PAGE_SEO } from '@config/seo';
---

<Layout {...PAGE_SEO.transfer}>
  <Nav bgClass="bg-black/70" />
  <TransferHero />
  <TransferIntro />
  <TransferProducts />
  <TransferGeometry />
  <TransferCta />
  <TransferFooter />
</Layout>
