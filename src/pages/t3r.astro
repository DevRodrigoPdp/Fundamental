---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { Factory, Bike, ShieldCheck, Timer, MapPin, Truck, Clock, Mail } from 'lucide-astro';
import '../styles/global.css';
import { SITE } from '../config/site';
import { catalogFamilies } from '../data/catalog-families';
import { pilares } from '../data/pilares';
import { cld } from '../lib/cloudinaryUrl';

const categorias = catalogFamilies;
---

<Layout
  title="T3R Bike Components | Recambios para bicicletas"
  description="Descubre T3R Bike Components: componentes y recambios para bicicleta probados por riders, pensados para tiendas, talleres y ciclistas."
  heroImage={cld('https://res.cloudinary.com/dxent4dkd/image/upload/v1783166514/catalogo_t3r/combos/combos_3.jpg', { width: 1920 })}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Brand',
    name: 'T3R Bike Components',
    alternateName: 'The Three Riders',
    url: `${SITE.url}/t3r`,
    logo: `${SITE.url}/logo_t3r.png`,
    description: 'Recambios y componentes para bicicletas probados por riders.',
  }}
>

  <style is:global>
    @keyframes marquee {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
    .marquee-track { animation: marquee 22s linear infinite; }
    .marquee-wrap:hover .marquee-track { animation-play-state: paused; }
    .t3r-family-card::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 3px;
      background: #C4A072;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .t3r-family-card:hover::after,
    .t3r-family-card:focus-visible::after {
      transform: scaleX(1);
    }
    @media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } }
    html { scroll-behavior: smooth; }
  </style>

  <Nav />

  <!-- HERO: split screen -->
  <section class="relative min-h-[100svh] bg-[#1A100C] overflow-hidden">
    <img src={cld('https://res.cloudinary.com/dxent4dkd/image/upload/v1783166514/catalogo_t3r/combos/combos_3.jpg', { width: 1920 })} alt="T3R productos y packaging"
      class="absolute inset-0 w-full h-full object-cover" style="object-position: center 40%;"
      loading="eager" fetchpriority="high" decoding="async" />
    <div class="absolute inset-0" style="background: linear-gradient(to top, #1A100C 0%, rgba(26,16,12,0.75) 40%, rgba(26,16,12,0.2) 100%);"></div>

    <div class="absolute inset-0 flex flex-col justify-end px-5 pb-10 sm:pb-14 md:px-16 md:pb-16 z-10">
      <div class="flex items-center gap-4 mb-6">
        <img src="/logo_blanco_t3r.png" alt="T3R" class="h-6 w-auto opacity-85" />
        <div class="w-px h-4 bg-white/20"></div>
        <p class="text-[10px] text-white/40 tracking-[0.35em] uppercase">The Three Riders</p>
      </div>
      <h1 class="text-[38px] sm:text-[50px] md:text-[80px] font-bold leading-[1.08] text-white tracking-tight mb-10">
        Directo de fábrica.<br/>Mejor calidad.<br/>
        <span class="text-[#C4A072]">Mejor precio.</span>
      </h1>
      <div class="flex items-start gap-6 max-w-sm mb-10">
        <div class="w-6 h-px bg-[#C4A072]/50 mt-3 shrink-0"></div>
        <p class="text-white/45 text-sm leading-relaxed">
          Componentes probados por nosotros. Sin intermediarios,buena calidad a un precio justo.
        </p>
      </div>
      <a href="/catalogo"
        class="bg-[#C4A072] text-[#1A100C] text-sm font-bold px-9 py-4 hover:bg-[#D4B280] transition-colors tracking-[0.1em] uppercase w-fit cursor-pointer">
        Ver catálogo
      </a>
    </div>
  </section>

  <main class="flex flex-col">
  <!-- FAMILIAS DE PRODUCTO -->
  <section id="categorias" class="order-[-20] relative overflow-hidden bg-white px-5 py-24 text-[#111111] md:px-16 md:py-28">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_75%_0%,rgba(196,160,114,0.16),transparent_34%)]"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-black/10"></div>
    <div class="relative mx-auto max-w-[1500px]">
      <div class="mb-14 grid gap-8 md:grid-cols-[0.9fr_1.1fr] md:items-end" data-reveal>
        <div>
          <p class="mb-6 text-xs uppercase tracking-[0.35em] text-[#C4A072]">Gama T3R</p>
          <h2 class="text-[36px] font-bold leading-[0.95] tracking-tight md:text-[64px]">
            Componentes y recambios<br />
            <span class="text-black/36">para bicicleta, probados por riders.</span>
          </h2>
        </div>
        <p class="max-w-xl text-base leading-relaxed text-black/52 md:justify-self-end">
          Seleccionamos buenos componentes y accesorios para ti, lo probamos y lo ofrecemos porque confiamos en ellos. Algunos de nuestros productos apenas se ven montados en la bici pero marcan la diferencia.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:gap-4 lg:grid-cols-4">
        {categorias.map((item, i) => (
          <a
            href={`/catalogo/familia/${item.slug}`}
            data-reveal
            data-delay={String(i % 4)}
            class="t3r-family-card group relative min-h-[180px] sm:min-h-[220px] md:min-h-[310px] overflow-hidden border border-black/10 bg-white transition-[border-color,box-shadow,background-color] duration-500 hover:border-[#C4A072]/55 hover:shadow-[0_24px_70px_rgba(17,17,17,0.10)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#C4A072]/60"
          >
            <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(196,160,114,0.14),transparent_42%)] opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>

            <div class="relative z-10 flex min-h-[inherit] flex-col justify-between p-4 md:p-6">
              <div>
                <div class="mb-5 flex items-center gap-3">
                  <span class="h-px w-7 bg-[#C4A072]"></span>
                  <p class="text-[10px] uppercase tracking-[0.32em] text-[#C4A072]">{item.tag}</p>
                </div>
                <h3
                  class:list={[
                    'max-w-sm font-bold leading-[0.95] tracking-tight',
                    'text-2xl md:text-[28px]',
                  ]}
                >
                  {item.cat}
                </h3>
                <p class="mt-4 max-w-sm text-[13px] leading-relaxed text-black/52">
                  {item.text}
                </p>
              </div>

              <div class="mt-7 flex items-end justify-between gap-2 lg:flex-col lg:items-end lg:justify-start lg:gap-3">
                <span class="inline-flex shrink-0 items-center gap-2 whitespace-nowrap text-[9px] sm:text-[10px] font-semibold uppercase tracking-[0.1em] sm:tracking-[0.18em] text-black/56 transition-colors group-hover:text-[#C4A072] lg:self-start">
                  <span>Ver referencias</span>
                  <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                </span>
                <img
                  src={cld(item.img, { width: 300 })}
                  alt={item.cat}
                  class:list={[
                    'object-contain transition-transform duration-700 group-hover:scale-105 group-hover:-rotate-2',
                    item.slug !== 'transmision' && 'drop-shadow-[0_24px_34px_rgba(0,0,0,0.16)]',
                    'h-12 w-12 shrink-0 self-end sm:h-16 sm:w-16 md:h-16 md:w-16 lg:h-20 lg:w-20 xl:h-28 xl:w-28 2xl:h-36 2xl:w-36',
                  ]}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- TICKER -->
  <div class="bg-[#C4A072] py-3.5 overflow-hidden marquee-wrap">
    <div class="flex whitespace-nowrap marquee-track">
      {Array(2).fill(null).map(() => (
        <span class="flex items-center">
          {['Directo de fábrica', 'Probado por nosotros', 'Precio competitivo', 'Fabricación de prestigio', 'Para la tienda y el cliente', 'Pensado para durar', 'The Three Riders', 'Sin intermediarios'].map(t => (
            <span class="font-bold text-[#1A100C] text-xs tracking-[0.25em] uppercase mx-8">{t} <span class="opacity-25 mx-2">·</span></span>
          ))}
        </span>
      ))}
    </div>
  </div>

  <!-- HISTORIA — EL PROBLEMA -->
  <section class="bg-[#1A100C] grid grid-cols-1 md:grid-cols-2">
    <div class="relative overflow-hidden h-64 md:h-auto md:min-h-[560px]">
      <img src={cld('https://res.cloudinary.com/dxent4dkd/image/upload/v1783166515/catalogo_t3r/combos/combos_5.jpg', { width: 1200 })} alt="T3R origen de la marca"
        class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-gradient-to-t from-[#1A100C]/40 via-transparent to-transparent"></div>
    </div>
    <div class="flex flex-col justify-center px-5 md:px-16 py-12 md:py-20" data-reveal>
      <p class="text-xs text-[#C4A072] tracking-[0.35em] uppercase mb-6">El problema</p>
      <h2 class="text-[32px] md:text-[46px] font-bold text-white leading-[0.95] tracking-tight mb-8">
        Una marca joven.<br/>
        <span class="text-[#C4A072]">Las ideas muy claras.</span>
      </h2>
      <p class="text-white/60 text-lg leading-relaxed max-w-md">
        Los mercados de todo el mundo sufren la competencia de precio que impone la globalización. T3R nace para cambiar esa ecuación: una cadena más corta significa precios más honestos para la tienda y para el cliente final.
      </p>
    </div>
  </section>

  <!-- PULL QUOTE -->
  <section class="bg-[#F0EDE8] px-5 md:px-16 py-24">
    <div class="max-w-4xl mx-auto text-center" data-reveal>
      <p class="text-[26px] md:text-[40px] font-bold text-[#1A100C] leading-snug">
        "Servir un buen producto al mejor precio,<br/>
        <span class="text-[#8B6B3F]">para la tienda y el cliente final.</span>"
      </p>
      <p class="text-[#8B6B3F] text-xs tracking-[0.3em] uppercase mt-8">The Three Riders</p>
    </div>
  </section>

  <!-- HISTORIA — LA PROPUESTA -->
  <section class="bg-[#1A100C] grid grid-cols-1 md:grid-cols-2">
    <div class="flex flex-col justify-center px-5 md:px-16 py-12 md:py-20 order-2" data-reveal>
      <p class="text-xs text-[#C4A072] tracking-[0.35em] uppercase mb-6">La propuesta</p>
      <h2 class="text-[32px] md:text-[46px] font-bold text-white leading-[0.95] tracking-tight mb-8">
        Probado por nosotros<br/>antes que por nadie.
      </h2>
      <div class="space-y-5 max-w-md">
        <p class="text-white/60 text-lg leading-relaxed">
          Cada referencia ha pasado por nuestras manos antes de llegar aquí.Probamos el producto, aprobamos el producto, nada entra en el catalogo sino pasa el filtro.
        </p>
        <p class="text-white/60 text-lg leading-relaxed">
          Fabricado en las mismas plantas que marcas de prestigio internacional, pensado para durar desde el ciclista amateur hasta el más experimentado.
        </p>
      </div>
    </div>
    <div class="relative overflow-hidden order-1 h-64 md:h-auto md:min-h-[560px]">
      <img src={cld('https://res.cloudinary.com/dxent4dkd/image/upload/v1783166517/catalogo_t3r/combos/combos_7.jpg', { width: 1200 })} alt="T3R probado por riders"
        class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-gradient-to-t from-[#1A100C]/40 via-transparent to-transparent"></div>
    </div>
  </section>

  <!-- FOTO SEPARADOR -->
  <div class="relative overflow-hidden h-[360px] md:h-[480px]">
    <img src={cld('https://res.cloudinary.com/dxent4dkd/image/upload/v1783166551/catalogo_t3r/discos_freno/center_lock/discos_freno_center_lock_4.jpg', { width: 1920 })} alt="Disco de freno T3R"
      class="absolute inset-0 w-full h-full object-cover" style="object-position: center 50%;"
      loading="lazy" decoding="async" />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(26,16,12,0.9) 0%, rgba(26,16,12,0.5) 55%, rgba(26,16,12,0.1) 100%);"></div>
    <div class="absolute inset-0 flex items-center px-5 md:px-16">
      <div data-reveal class="max-w-lg">
        <p class="text-xs text-[#C4A072] tracking-[0.35em] uppercase mb-4">Fabricación contrastada</p>
        <p class="text-white text-2xl md:text-3xl font-bold leading-snug">
          Ningún producto entra al catálogo sin pasar por nuestras manos primero.
        </p>
      </div>
    </div>
  </div>

  <!-- PILARES -->
  <section class="relative overflow-hidden border-t border-white/5 bg-[#1A100C] px-5 py-24 md:px-16 md:py-28">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_15%_0%,rgba(196,160,114,0.10),transparent_30%)]"></div>
    <div class="relative mx-auto max-w-7xl">
      <div class="mb-14 grid gap-8 md:grid-cols-[0.9fr_1.1fr] md:items-end" data-reveal>
        <div>
          <p class="mb-6 text-xs uppercase tracking-[0.35em] text-[#C4A072]">Nuestros compromisos</p>
          <h2 class="text-[36px] font-bold leading-[0.95] tracking-tight text-white md:text-[64px]">
            Cuatro principios.<br />
            <span class="text-white/35">Cero atajos.</span>
          </h2>
        </div>
        <p class="max-w-xl text-base leading-relaxed text-white/48 md:justify-self-end">
          Lo que entra en una caja T3R tiene que cumplir una regla sencilla: aportar valor real al cliente y funcionar cuando toca.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3 xl:grid-cols-4">
        {pilares.map((p, i) => (
          <article
            class="group relative min-h-[260px] md:min-h-[340px] overflow-hidden border border-white/8 bg-white/[0.025] p-5 md:p-8 transition-[border-color,background-color,box-shadow] duration-500 hover:border-[#C4A072]/45 hover:bg-[#C4A072]/[0.055] hover:shadow-[0_26px_70px_rgba(0,0,0,0.24)]"
            data-reveal
            data-delay={String(i)}
          >
            <div class="absolute inset-x-0 bottom-0 h-[3px] origin-left scale-x-0 bg-[#C4A072] transition-transform duration-500 group-hover:scale-x-100"></div>

            <div class="mb-5 md:mb-12 flex items-start">
              <div class="flex h-14 w-14 items-center justify-start text-[#C4A072] transition-colors duration-500 group-hover:text-[#D8B98D]">
                {p.icon === 'factory' && <Factory size={27} stroke-width={1.5} />}
                {p.icon === 'rider' && <Bike size={27} stroke-width={1.5} />}
                {p.icon === 'shield' && <ShieldCheck size={27} stroke-width={1.5} />}
                {p.icon === 'durability' && <Timer size={27} stroke-width={1.5} />}
              </div>
            </div>

            <div class="mb-6 h-px w-10 bg-[#C4A072]/55 transition-[width,background-color] duration-500 group-hover:w-20 group-hover:bg-[#C4A072]"></div>
            <h3 class="mb-4 max-w-[13rem] text-2xl font-semibold leading-tight tracking-tight text-white">
              {p.title}
            </h3>
            <p class="max-w-[17rem] text-sm leading-7 text-white/45 transition-colors duration-500 group-hover:text-white/62">
              {p.text}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PACKAGING -->
  <section class="bg-white grid grid-cols-1 md:grid-cols-2">
    <div class="relative overflow-hidden h-64 md:h-auto md:min-h-[480px]">
      <img src={cld('https://res.cloudinary.com/dxent4dkd/image/upload/v1783166518/catalogo_t3r/combos/combos_8.jpg', { width: 1200 })} alt="Packaging T3R"
        class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/15 via-transparent to-transparent"></div>
    </div>
    <div class="flex flex-col justify-center px-5 md:px-16 py-12 md:py-20 text-[#111111]" data-reveal>
      <p class="text-xs text-[#C4A072] tracking-[0.35em] uppercase mb-6">La filosofía</p>
      <h2 class="text-[32px] md:text-[46px] font-bold leading-tight tracking-tight mb-8">
        El packaging no es<br/>el producto.
      </h2>
      <p class="text-black/55 text-lg leading-relaxed max-w-md mb-10">
        Cartón. Sin logotipos a color, sin envases llamativos. Cada euro que no gastamos en envoltorio es un euro que va al componente y al precio final.
      </p>
      <div class="border border-[#C4A072]/40 bg-[#C4A072]/[0.05] p-8 max-w-sm">
        <p class="text-[#C4A072] text-xs tracking-[0.3em] uppercase mb-4">Filosofía T3R</p>
        <p class="text-[#1A100C] text-xl font-bold leading-tight">
          "Minimizar el coste donde no afecta a la calidad."
        </p>
      </div>
    </div>
  </section>

  <!-- CÓMO TRABAJAMOS / QUÉ OFRECEMOS A UNA TIENDA -->
  <section class="relative overflow-hidden bg-[#1A100C] border-t border-white/5 px-5 md:px-16 py-24 md:py-28">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_85%_100%,rgba(196,160,114,0.08),transparent_36%)]"></div>
    <div class="relative mx-auto grid max-w-6xl gap-16 md:grid-cols-2">
      <div data-reveal>
        <h2 class="text-xs text-[#C4A072] tracking-[0.35em] uppercase mb-10">Cómo trabajamos</h2>
        <div class="space-y-5 text-base md:text-lg text-white/55 leading-relaxed">
          <p>
            Seleccionamos cada producto, lo probamos nosotros mismos y solo entonces lo ofrecemos a las tiendas que confían en nosotros. Trabajamos directo con fábrica para acortar la cadena y ofrecer un precio honesto, tanto a la tienda como al cliente final.
          </p>
          <p>
            Nos encargamos de la gestión completa: desde la disponibilidad de producto hasta el envío y el soporte técnico si surge alguna duda sobre piezas o compatibilidad.
          </p>
        </div>
      </div>
      <div data-reveal data-delay="1">
        <h2 class="text-xs text-[#C4A072] tracking-[0.35em] uppercase mb-10">Qué ofrecemos a una tienda</h2>
        <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div class="group border border-white/8 p-5 transition-colors duration-300 hover:border-[#C4A072]/40 hover:bg-white/[0.02]">
            <MapPin size={20} stroke-width={1.5} class="mb-5 text-[#C4A072]" aria-hidden="true" />
            <dt class="text-[11px] uppercase tracking-widest text-white/35 mb-1.5">Cobertura geográfica</dt>
            <dd class="text-base font-medium text-white">Toda España</dd>
          </div>
          <div class="group border border-white/8 p-5 transition-colors duration-300 hover:border-[#C4A072]/40 hover:bg-white/[0.02]">
            <Truck size={20} stroke-width={1.5} class="mb-5 text-[#C4A072]" aria-hidden="true" />
            <dt class="text-[11px] uppercase tracking-widest text-white/35 mb-1.5">Servicio a tiendas</dt>
            <dd class="text-base font-medium text-white">Envío directo a tienda y soporte técnico sobre piezas y compatibilidad</dd>
          </div>
          <div class="group border border-white/8 p-5 transition-colors duration-300 hover:border-[#C4A072]/40 hover:bg-white/[0.02]">
            <Clock size={20} stroke-width={1.5} class="mb-5 text-[#C4A072]" aria-hidden="true" />
            <dt class="text-[11px] uppercase tracking-widest text-white/35 mb-1.5">Plazos de entrega</dt>
            <dd class="text-base font-medium text-white">Gestionados por Correos o mensajería privada, según destino</dd>
          </div>
          <div class="group border border-white/8 p-5 transition-colors duration-300 hover:border-[#C4A072]/40 hover:bg-white/[0.02]">
            <Mail size={20} stroke-width={1.5} class="mb-5 text-[#C4A072]" aria-hidden="true" />
            <dt class="text-[11px] uppercase tracking-widest text-white/35 mb-1.5">Contacto comercial</dt>
            <dd class="text-base font-medium text-white break-words">info@fundamentalbikeparts.com</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  </main>

  <!-- FOOTER -->
  <footer class="bg-[#1A100C] border-t border-white/5 px-5 md:px-16 pt-14 pb-10">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-3 mb-12 pb-12 border-b border-white/10 text-center md:text-left">
        <div>
          <img src="/logo_blanco_t3r.png" alt="T3R" class="h-6 w-auto opacity-85 mx-auto md:mx-0 mb-4" />
          <p class="text-sm font-semibold text-white mb-1">T3R · The Three Riders × Fundamental</p>
          <p class="text-xs text-white/40 leading-relaxed">Distribuido por Fundamental Bike Parts · Madrid, España</p>
        </div>
        <div>
          <p class="text-xs text-white/40 tracking-[0.25em] uppercase mb-4">Explorar</p>
          <div class="flex flex-col gap-2">
            <a href="/catalogo" class="text-sm text-white/55 hover:text-[#C4A072] transition-colors">Catálogo</a>
            <a href="/nosotros" class="text-sm text-white/55 hover:text-[#C4A072] transition-colors">Nosotros</a>
            <a href="/puntos-de-venta" class="text-sm text-white/55 hover:text-[#C4A072] transition-colors">Puntos de venta</a>
          </div>
        </div>
        <div>
          <p class="text-xs text-white/40 tracking-[0.25em] uppercase mb-4">Contacto</p>
          <div class="flex flex-col gap-2">
            <a href="/contacto" class="text-sm text-white/55 hover:text-[#C4A072] transition-colors">Contacto comercial</a>
            <a href="mailto:info@fundamentalbikeparts.com" class="text-sm text-white/55 hover:text-[#C4A072] transition-colors">info@fundamentalbikeparts.com</a>
          </div>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left">
        <p class="text-xs text-white/20">© 2026 FUNDAMENTAL</p>
        <div class="flex items-center gap-4">
          <a href="https://www.instagram.com/fundamental_bike_parts?igsh=OWtqdjN6MXdrcDdl" target="_blank" rel="noopener noreferrer" aria-label="Instagram de Fundamental" class="text-white/45 transition-colors hover:text-[#C4A072]">
