---
import Layout from '@layouts/BaseLayout.astro';
import Nav from '@components/layout/Nav/Nav.astro';
import T3rEffects from '@components/features/brand/t3r/T3rEffects.astro';
import T3rHero from '@components/features/brand/t3r/T3rHero.astro';
import T3rFamilies from '@components/features/brand/t3r/T3rFamilies.astro';
import T3rTicker from '@components/features/brand/t3r/T3rTicker.astro';
import T3rProblem from '@components/features/brand/t3r/T3rProblem.astro';
import T3rQuote from '@components/features/brand/t3r/T3rQuote.astro';
import T3rProposal from '@components/features/brand/t3r/T3rProposal.astro';
import T3rPhotoDivider from '@components/features/brand/t3r/T3rPhotoDivider.astro';
import T3rPillars from '@components/features/brand/t3r/T3rPillars.astro';
import T3rPackaging from '@components/features/brand/t3r/T3rPackaging.astro';
import T3rServices from '@components/features/brand/t3r/T3rServices.astro';
import T3rFooter from '@components/features/brand/t3r/T3rFooter.astro';
import '@styles/global.css';
import { PAGE_SEO } from '@config/seo';
---

<Layout {...PAGE_SEO.t3r}>
  <T3rEffects />
  <Nav />
  <T3rHero />

  <main class="flex flex-col">
    <T3rFamilies />
    <T3rTicker />
    <T3rProblem />
    <T3rQuote />
    <T3rProposal />
    <T3rPhotoDivider />
    <T3rPillars />
    <T3rPackaging />
    <T3rServices />
  </main>

  <T3rFooter />
</Layout>
