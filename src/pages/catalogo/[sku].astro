---
import Layout from '@layouts/BaseLayout.astro';
import Nav from '@components/layout/Nav/Nav.astro';
import SimpleFooter from '@components/layout/Footer/SimpleFooter.astro';
import ProductBreadcrumb from '@components/features/product/ProductBreadcrumb.astro';
import ProductGallery from '@components/features/product/ProductGallery.astro';
import ProductInfo from '@components/features/product/ProductInfo.astro';
import RelatedProducts from '@components/features/product/RelatedProducts.astro';
import { getActiveSkus, getProductDetail } from '@lib/services/productDetail';
import { productDescription, productSchemas } from '@lib/seo/schema';

export async function getStaticPaths() {
  const skus = await getActiveSkus();
  return skus.map((sku) => ({ params: { sku } }));
}

const detail = await getProductDetail(Astro.params.sku as string);
if (!detail) {
  return Astro.redirect('/catalogo');
}

const { product, images, related, isDiskFamily, diskVariants } = detail;
---

<Layout
  title={`${product.nombre} | T3R Fundamental`}
  description={productDescription(product)}
  image={images[0] ?? '/logo_t3r.png'}
  type="product"
  structuredData={productSchemas(product, images)}
>
  <Nav />

  <section class="px-5 md:px-16 pb-24" style="padding-top: 110px;">
    <ProductBreadcrumb product={product} />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-20">
      <ProductGallery images={images} alt={product.nombre} />
      <ProductInfo product={product} diskVariants={diskVariants} />
    </div>
  </section>

  {!isDiskFamily && related.length > 0 && (
    <RelatedProducts title={product.categoria} products={related} />
  )}

  <SimpleFooter title="T3R × Fundamental" showContactLink />
</Layout>
