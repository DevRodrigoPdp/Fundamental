---
import Layout from '@layouts/BaseLayout.astro';
import Nav from '@components/layout/Nav/Nav.astro';
import BackToTop from '@components/ui/BackToTop.astro';
import FamilyIntro from '@components/features/catalog/FamilyIntro.astro';
import FamilyProducts from '@components/features/catalog/FamilyProducts.astro';
import { SITE, absoluteUrl } from '@config/site';
import { getFamilyPages } from '@lib/services/catalogFamilies';
import { breadcrumbSchema, collectionPageSchema } from '@lib/seo/schema';
import type { CatalogFamily } from '@app-types/catalog';
import type { ProductCardData } from '@app-types/product';

export async function getStaticPaths() {
  const pages = await getFamilyPages();
  return pages.map(({ family, products }) => ({
    params: { slug: family.slug },
    props: { family, products },
  }));
}

const { family, products } = Astro.props as {
  family: CatalogFamily;
  products: ProductCardData[];
};

const familyUrl = absoluteUrl(`/catalogo/familia/${family.slug}/`);
const schema = [
  collectionPageSchema({ name: family.cat, description: family.description, url: familyUrl }),
  breadcrumbSchema([
    { name: 'Inicio', item: SITE.url },
    { name: 'T3R', item: absoluteUrl('/t3r') },
    { name: family.cat, item: familyUrl },
  ]),
];
---

<Layout
  title={`${family.cat} | Catálogo T3R`}
  description={family.description}
  image={family.img}
  structuredData={schema}
>
  <Nav />
  <BackToTop />

  <main class="px-5 pb-28 pt-28 md:px-16 md:pt-36">
    <div class="mx-auto max-w-[1500px]">
      <nav class="mb-10 flex flex-wrap items-center gap-3 text-sm">
        <a href="/t3r#categorias" class="text-gray-400 transition-colors hover:text-black">Gama T3R</a>
        <span class="text-gray-300">/</span>
        <span class="text-gray-700">{family.cat}</span>
      </nav>

      <div class="grid items-start gap-12 lg:grid-cols-[320px_minmax(0,1fr)] xl:grid-cols-[380px_minmax(0,1fr)] xl:gap-20">
        <FamilyIntro family={family} />
        <FamilyProducts products={products} />
      </div>
    </div>
  </main>
</Layout>
