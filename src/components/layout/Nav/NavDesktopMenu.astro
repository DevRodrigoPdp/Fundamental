---
import { navLinks as links, type NavKey } from '@config/navigation';
import { isNavActive } from '@lib/utils/navigation';

interface Props {
  active?: NavKey;
  currentPath: string;
}

const { active, currentPath } = Astro.props;
const isActive = (href: string, key: NavKey) => isNavActive(href, key, active, currentPath);
---

<nav class="hidden items-center gap-10 lg:flex" aria-label="Menú principal">
  {
    links.map((link) => {
      const current = isActive(link.href, link.key);
      return (
        <a
          href={link.href}
          class:list={[
            'relative whitespace-nowrap py-1 text-[15px] font-medium transition-colors duration-200',
            'after:absolute after:inset-x-0 after:-bottom-0.5 after:h-[2px] after:origin-left after:bg-[#C4A072] after:transition-transform after:duration-300',
            current ? 'text-white after:scale-x-100' : 'text-white/70 after:scale-x-0 hover:text-white hover:after:scale-x-100',
          ]}
          aria-current={current ? 'page' : undefined}
        >
          {link.label}
        </a>
      );
    })
  }
</nav>
