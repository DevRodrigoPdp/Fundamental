---
import { SITE } from '@config/site';
import { navLinks as links, type NavKey } from '@config/navigation';
import { isNavActive } from '@lib/utils/navigation';

interface Props {
  active?: NavKey;
  currentPath: string;
}

const { active, currentPath } = Astro.props;
const isActive = (href: string, key: NavKey) => isNavActive(href, key, active, currentPath);
---

<div
  id="nav-mobile-menu"
  class="pointer-events-none fixed inset-0 z-40 translate-y-[-10px] overflow-y-auto overscroll-contain bg-[#0b0908] px-5 pb-[max(2.5rem,env(safe-area-inset-bottom))] pt-28 opacity-0 transition-[opacity,transform] duration-300 ease-out lg:hidden"
  aria-hidden="true"
  inert
>
  <nav class="mx-auto flex max-w-md flex-col gap-2" aria-label="Navegación móvil">
    {
      links.map((link) => {
        const current = isActive(link.href, link.key);
        return (
          <a
            href={link.href}
            class:list={[
              'nav-menu-link py-3 text-[32px] font-semibold leading-tight tracking-[-0.025em] transition-colors',
              current ? 'text-[#C4A072]' : 'text-white hover:text-[#C4A072]',
            ]}
            aria-current={current ? 'page' : undefined}
          >
            {link.label}
          </a>
        );
      })
    }
  </nav>
  <a
    href={SITE.instagram}
    target="_blank"
    rel="noopener noreferrer"
    class="nav-menu-link mx-auto mt-10 flex max-w-md items-center gap-2 text-base font-medium text-white/70 transition-colors hover:text-[#C4A072]"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".75" fill="currentColor" stroke="none"/></svg>
    Instagram
  </a>
</div>

<style>
  .nav-menu-link {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.28s ease-out, transform 0.28s ease-out, color 0.2s;
  }

  #nav-mobile-menu.is-open .nav-menu-link {
    opacity: 1;
    transform: translateY(0);
  }

  #nav-mobile-menu.is-open .nav-menu-link:nth-child(1) { transition-delay: 0.04s; }
  #nav-mobile-menu.is-open .nav-menu-link:nth-child(2) { transition-delay: 0.08s; }
  #nav-mobile-menu.is-open .nav-menu-link:nth-child(3) { transition-delay: 0.12s; }
  #nav-mobile-menu.is-open .nav-menu-link:nth-child(4) { transition-delay: 0.16s; }

  @media (prefers-reduced-motion: reduce) {
    #nav-mobile-menu,
    .nav-menu-link {
      transition: none !important;
    }
  }
</style>
