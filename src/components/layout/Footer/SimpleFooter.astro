---
import InstagramLink from '@components/ui/InstagramLink.astro';

interface Props {
  title: string;
  // Clases de layout del <footer> (borde y padding varían por página)
  class?: string;
  showContactLink?: boolean;
}

const {
  title,
  class: className = 'border-t border-gray-100 px-5 md:px-16 py-10',
  showContactLink = false,
} = Astro.props;
---

<footer class={`${className} flex flex-col md:flex-row items-center md:items-start justify-between gap-4 text-center md:text-left`}>
  <div>
    <p class="text-base font-bold mb-2">{title}</p>
    <p class="text-sm text-gray-400 max-w-[240px] leading-relaxed">
      Distribuidora de componentes profesionales para ciclismo. Madrid, España.
    </p>
    {showContactLink && (
      <a href="/contacto" class="inline-block mt-3 text-sm text-[#6B8CAE] hover:underline">Contacto →</a>
    )}
  </div>
  <div class="flex items-center gap-4 text-gray-400">
    <InstagramLink />
    <p class="text-sm">© 2026 FUNDAMENTAL</p>
  </div>
</footer>
