---
import { cld } from '@lib/cloudinary/url';
import { WHIPP_OFF_HERO_IMAGE } from '@config/whippOff';
---

<section class="relative min-h-[100svh] bg-black flex flex-col justify-end overflow-hidden">
  <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${cld(WHIPP_OFF_HERO_IMAGE, { width: 1920 })}');`}></div>
  <div class="absolute inset-0" style="background: linear-gradient(to top, #000 0%, rgba(0,0,0,0.55) 45%, rgba(0,0,0,0.1) 100%);"></div>

  <!-- Badge web oficial top-right -->
  <a
    href="https://www.whip-off.com/"
    target="_blank"
    rel="noopener noreferrer"
    class="absolute top-24 md:top-28 right-5 md:right-16 z-20 flex items-center gap-2 border border-white/30 bg-black/40 backdrop-blur-sm px-3 md:px-4 py-2 md:py-2.5 text-white hover:bg-white hover:text-black transition-all duration-300 group cursor-pointer"
  >
    <span class="font-epilogue text-[10px] md:text-xs tracking-[0.2em] uppercase">whip-off.com</span>
    <svg class="w-3 h-3 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10"/>
    </svg>
  </a>

  <div class="relative z-20 px-5 pb-10 sm:pb-14 md:px-16 md:pb-16">
    <img src="/logo_whipoff.png" alt="Whipp-Off" class="h-9 md:h-12 w-auto mb-8 brightness-0 invert" />
    <p class="font-epilogue text-xs text-white/50 tracking-[0.4em] uppercase mb-4">Ropa MTB · Fundamental</p>
    <h1 class="font-anton text-[64px] sm:text-[88px] md:text-[120px] leading-[0.85] text-white uppercase mb-8" style="letter-spacing: -0.02em;">
      WHIPP<br/>
      <span class="text-white">OFF.</span>
    </h1>
    <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6">
      <p class="font-epilogue text-white/70 text-base leading-relaxed">
        Para quienes rompen la línea recta.
      </p>
      <a
        href="https://www.whip-off.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="font-epilogue text-xs text-white/70 tracking-[0.2em] uppercase border-b border-white/30 pb-0.5 hover:text-white hover:border-white transition-colors cursor-pointer"
      >
        Ver web oficial →
      </a>
    </div>
  </div>
</section>
