---
// Hero con vídeo controlado por scroll: los frames de public/hero-frames se dibujan en un
// <canvas> según el avance del scroll dentro de la sección (sticky). El primer frame va como
// <img> para que pinte al instante (LCP) y sirve de fallback sin JS o con reduced motion.
const FRAME_COUNT = 128;
const framePath = (i: number) => `/hero-frames/frame_${String(i).padStart(4, '0')}.webp`;
---

<section
  id="hero-scrub"
  class="hero-scrub relative bg-[#1A100C]"
  data-frame-count={FRAME_COUNT}
  data-frame-base="/hero-frames/frame_"
>
  <div class="sticky top-0 h-[100svh] overflow-hidden">
    <img
      src={framePath(1)}
      alt="Componentes T3R: pedales, discos de freno, pastillas y eje de pedalier"
      class="hero-scrub-poster absolute inset-0 h-full w-full object-cover"
      width="1280"
      height="720"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <canvas class="hero-scrub-canvas absolute inset-0 h-full w-full opacity-0 transition-opacity duration-300" aria-hidden="true"></canvas>
    <div class="absolute inset-0" style="background: linear-gradient(to top, #1A100C 0%, rgba(26,16,12,0.75) 35%, rgba(26,16,12,0.15) 100%);"></div>

    <div class="absolute inset-0 z-10 flex flex-col justify-end px-5 pb-10 sm:pb-14 md:px-16 md:pb-16">
      <div class="mb-6 flex items-center gap-4">
        <img src="/images/t3r-logo-blanco.webp" alt="T3R" width="400" height="157" class="h-6 w-auto opacity-85" />
        <div class="h-4 w-px bg-white/20"></div>
        <p class="text-[10px] uppercase tracking-[0.35em] text-white/40">The Three Riders · by Fundamental</p>
      </div>
      <h1 class="mb-10 text-[38px] font-bold leading-[1.08] tracking-tight text-white sm:text-[50px] md:text-[80px]">
        <span class="sr-only">T3R Components, distribuido por Fundamental Bike Parts. </span>
        Directo de fábrica.<br />Mejor calidad.<br />
        <span class="text-[#C4A072]">Mejor precio.</span>
      </h1>
      <div class="mb-10 flex max-w-sm items-start gap-6">
        <div class="mt-3 h-px w-6 shrink-0 bg-[#C4A072]/50"></div>
        <p class="text-sm leading-relaxed text-white/45">
          Componentes probados por nosotros. Sin intermediarios, buena calidad a un precio justo.
        </p>
      </div>
      <a href="/catalogo"
        class="w-fit cursor-pointer bg-[#C4A072] px-9 py-4 text-sm font-bold uppercase tracking-[0.1em] text-[#1A100C] transition-colors hover:bg-[#D4B280]">
        Ver catálogo
      </a>
    </div>

    <div class="hero-scrub-hint pointer-events-none absolute bottom-6 right-5 z-10 hidden flex-col items-center gap-3 md:right-16 md:flex" aria-hidden="true">
      <span class="text-[9px] uppercase tracking-[0.3em] text-white/40 [writing-mode:vertical-rl]">Desliza</span>
      <span class="relative block h-12 w-px overflow-hidden bg-white/15">
        <span class="hero-scroll-line absolute left-0 w-px bg-[#C4A072]"></span>
      </span>
    </div>
  </div>
</section>

<style>
  /* Altura = recorrido del scroll que consume la animación (1 pantalla fija + 0,8 de scrub). */
  .hero-scrub { height: 180svh; }
  @media (max-width: 767px) { .hero-scrub { height: 150svh; } }
  @media (prefers-reduced-motion: reduce) {
    .hero-scrub { height: 100svh; }
    .hero-scrub-canvas, .hero-scrub-hint { display: none; }
  }
</style>

<script>import '@scripts/home/heroScrub';</script>
