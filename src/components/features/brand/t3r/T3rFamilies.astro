---
import { cld } from '@lib/cloudinary/url';
import { catalogFamilies as categorias } from '@config/catalogFamilies';
// Familias de producto: el producto grande sobre gris (mismo lenguaje que Novedades),
// sin bordes, sombras ni degradados; el texto debajo en tamaño legible.
---

<section id="categorias" class="bg-white px-5 py-20 text-[#111111] md:px-12 md:py-28">
  <div class="mx-auto max-w-7xl">
    <div class="mb-12 grid gap-6 md:mb-16 md:grid-cols-12 md:items-end md:gap-8" data-reveal>
      <div class="md:col-span-8">
        <p class="mb-4 text-sm font-semibold text-[#8B6B3F]">Gama T3R</p>
        <h2 class="text-[clamp(30px,3.6vw,52px)] font-bold leading-[1.05] tracking-[-0.025em]">
          Componentes y recambios para bicicleta, probados por riders.
        </h2>
      </div>
      <p class="max-w-md text-[17px] leading-[1.6] text-[#3D3A36] md:col-span-4 md:justify-self-end">
        Seleccionamos buenos componentes y accesorios para ti, lo probamos y lo ofrecemos porque confiamos en ellos. Algunos de nuestros productos apenas se ven montados en la bici pero marcan la diferencia.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-x-4 gap-y-10 lg:grid-cols-4 lg:gap-y-14">
      {categorias.map((item, i) => (
        <a
          href={`/catalogo/familia/${item.slug}`}
          data-reveal
          data-delay={String(i % 4)}
          class="group flex h-full flex-col focus-visible:outline-none"
        >
          <div class="relative mb-5 aspect-square overflow-hidden bg-[#F2F2F2] group-focus-visible:ring-2 group-focus-visible:ring-[#C4A072]">
            <img
              src={cld(item.img, { width: 400, height: 400, trim: true })}
              alt={item.cat}
              width="600"
              height="600"
              class="absolute inset-0 h-full w-full object-contain p-[16%] mix-blend-multiply transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.06]"
              loading="lazy"
              decoding="async"
            />
          </div>
          <p class="mb-1.5 text-sm font-medium text-[#8B6B3F]">{item.tag}</p>
          <h3 class="mb-2 text-xl font-bold leading-tight tracking-tight md:text-2xl">{item.cat}</h3>
          <p class="mb-4 flex-1 text-[15px] leading-[1.55] text-[#3D3A36]">{item.text}</p>
          <span class="inline-flex items-center gap-2 text-sm font-semibold text-[#1A100C] transition-colors group-hover:text-[#8B6B3F]">
            Ver referencias
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
