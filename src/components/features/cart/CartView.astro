---
import CartSummary from './CartSummary.astro';
---

<section class="px-5 md:px-16 pb-24" style="padding-top: 110px;">
  <p class="text-sm text-[#6B8CAE] tracking-[0.25em] uppercase mb-4">Compra</p>
  <h1 class="text-[28px] md:text-[40px] font-bold leading-tight mb-10">Tu cesta</h1>

  <p data-cart-state="loading" class="text-sm text-gray-400">Cargando cesta…</p>

  <div data-cart-state="empty" class="hidden border border-gray-200 px-6 py-16 text-center">
    <p class="text-lg font-semibold mb-2">Tu cesta está vacía</p>
    <p class="text-sm text-gray-500 mb-8">Añade productos desde el catálogo.</p>
    <a href="/catalogo" class="inline-flex items-center gap-3 bg-black text-white text-sm font-medium px-10 py-4 hover:bg-[#222] transition-colors">
      Ver catálogo <span>→</span>
    </a>
  </div>

  <p data-cart-state="error" class="hidden text-sm text-red-600">
    No se ha podido cargar la cesta. Recarga la página o inténtalo más tarde.
  </p>

  <div data-cart-state="list" class="hidden grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-10 lg:gap-16">
    <ul data-cart-lines class="divide-y divide-gray-200 border-y border-gray-200"></ul>
    <CartSummary />
  </div>
</section>

<script>import '@scripts/cart/cartPage';</script>
