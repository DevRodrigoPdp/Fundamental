---
import { SITE } from '@config/site';
---

<section class="nosotros-hero">
  <div class="nosotros-hero__inner mx-auto flex max-w-6xl items-end px-5 pb-16 md:px-8 md:pb-24">
    <div class="relative z-10 max-w-3xl">
      <p class="mb-6 text-[10px] font-bold uppercase tracking-[0.36em] text-white/70">Nosotros</p>
      <h1 class="text-[44px] font-black leading-[0.9] tracking-[-0.065em] md:text-[80px]">
        Creemos en lo que montamos.
      </h1>
      <a
        href={SITE.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="group mt-7 inline-flex items-center gap-2.5 text-base text-white/80 transition-colors hover:text-white md:text-lg"
        aria-label="Instagram de Fundamental: @fundamental_bike_parts"
      >
        <svg class="size-[1.15em] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".75" fill="currentColor" stroke="none"/></svg>
        <span class="underline decoration-white/0 decoration-1 underline-offset-[6px] transition-[text-decoration-color] duration-300 group-hover:decoration-white/70">@fundamental_bike_parts</span>
        <span class="text-white/50 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .nosotros-hero {
    position: relative;
    margin-top: 76px;
    min-height: calc(100svh - 76px);
    overflow: hidden;
    color: white;
    /* WebP ligero: 60 KB en móvil, 125 KB en escritorio (antes JPG de 400 KB). */
    background-image: url('/images/nosotros-hero-900.webp');
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    isolation: isolate;
  }

  .nosotros-hero::before,
  .nosotros-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .nosotros-hero::before {
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.84), rgba(0, 0, 0, 0.36) 52%, rgba(0, 0, 0, 0.08));
  }

  .nosotros-hero::after {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.24) 45%, rgba(0, 0, 0, 0.82));
  }

  .nosotros-hero__inner {
    position: relative;
    min-height: calc(100svh - 76px);
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .nosotros-hero {
      margin-top: 84px;
      min-height: calc(100svh - 84px);
    }

    .nosotros-hero__inner {
      min-height: calc(100svh - 84px);
    }
  }

  @media (min-width: 1024px) {
    .nosotros-hero {
      margin-top: 72px;
      min-height: calc(100svh - 72px);
    }

    .nosotros-hero__inner {
      min-height: calc(100svh - 72px);
    }
  }

</style>
