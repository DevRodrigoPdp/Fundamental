---
import { cld } from '@lib/cloudinary/url';
import CatalogCardAction from './CatalogCardAction.astro';
import { money } from '@lib/utils/format';
import { stockBadge } from '@lib/utils/stock';
import type { CatalogItem } from '@app-types/product';

interface Props {
  product: CatalogItem;
  index: number;
}

const { product: p, index } = Astro.props;
const badge = stockBadge(p.estadoStock);
---

<div
  data-product-card
  data-search={`${p.nombre} ${p.categoria} ${p.subcategoria ?? ''} ${p.sku}`.toLowerCase()}
  data-name={p.nombre}
  data-category={p.categoria}
  data-subcategory={p.subcategoria ?? ''}
  data-sku={p.searchSku ?? p.sku}
  data-product-id={p.sku}
  data-reveal data-delay={String(index % 4)}
  class="group flex flex-col border border-gray-200 bg-white transition-[border-color,box-shadow] duration-300 hover:border-gray-400 hover:shadow-[0_12px_34px_rgba(0,0,0,0.06)]"
>
  <a href={`/catalogo/${p.sku}`} class="block cursor-pointer">
    <div class="relative overflow-hidden bg-white aspect-[4/3]">
      {p.imagen ? (
        <img
          src={cld(p.imagen, { width: 500 })}
          alt={p.nombre}
          class="absolute inset-0 h-full w-full object-contain p-4 sm:p-5 transition-transform duration-500 group-hover:scale-[1.025]"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-white text-gray-300">
          <img src="/logo_t3r.png" alt="T3R" class="w-20 opacity-25 grayscale" loading="lazy" />
          <p class="text-[10px] tracking-[0.25em] uppercase text-gray-300">Foto próximamente</p>
        </div>
      )}
    </div>
    <div class="px-5 pt-5">
      <p class="mb-2 text-[9px] uppercase tracking-[0.22em] text-gray-400">{p.subcategoria ?? p.categoria}</p>
      <h3 class="mb-2 line-clamp-2 break-words text-[15px] font-bold leading-snug transition-colors group-hover:text-[#6B8CAE] sm:text-base">{p.nombre}</h3>
      {p.descripcion && (
        <p class="mb-4 line-clamp-2 text-xs leading-relaxed text-gray-500 sm:text-sm">{p.descripcion}</p>
      )}
      {badge && (
        <p class:list={['mb-5 text-xs font-semibold uppercase tracking-[0.12em]', badge.color]}>
          {badge.label}
        </p>
      )}
    </div>
  </a>
  <div class="flex flex-1 flex-col px-5 pb-5">
    <div class="mt-auto border-t border-gray-100 pt-4">
      <div class="mb-4 flex items-baseline justify-between gap-3">
        <p class="min-w-0 truncate text-[11px] text-gray-400">{p.refLabel ?? p.sku}</p>
        {p.maxQty > 0 && !p.refLabel ? (
          <p class="shrink-0 text-base font-bold text-black">{money.format(p.precio as number)}</p>
        ) : (
          <p class="shrink-0 text-[11px] text-gray-400">{p.refLabel ? 'Varias medidas' : 'Consultar precio'}</p>
        )}
      </div>
      <CatalogCardAction product={p} />
    </div>
  </div>
</div>
