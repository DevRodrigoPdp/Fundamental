---
import { getCatalogFilters } from '@config/productTaxonomy';

const filters = getCatalogFilters();
---

<aside id="catalog-filters" class="hidden border border-gray-200 bg-[#faf9f7] lg:sticky lg:top-28 lg:block">
  <div class="border-b border-gray-200 px-5 py-4">
    <div>
      <p class="text-[9px] uppercase tracking-[0.26em] text-gray-500">Catálogo T3R</p>
      <h2 class="mt-1 text-base font-bold leading-tight">Filtrar productos</h2>
    </div>
  </div>

  <div class="p-5">
    <div class="mb-3 flex items-center justify-between gap-3">
      <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-gray-500">Categorías</p>
      <button id="sidebar-clear" type="button" style="display: none; font-size: 10px; line-height: 1;" class="inline-flex items-center gap-1 font-semibold uppercase tracking-[0.2em] text-[#111] underline-offset-4 transition-colors hover:underline">
        <svg class="h-2 w-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" d="m6 6 12 12M18 6 6 18"/></svg>
        Limpiar
      </button>
    </div>
    <!-- -mx-3: el texto de cada opción queda alineado con los títulos; el fondo activo sobresale a ambos lados. -->
    <div class="flex flex-wrap gap-2 lg:-mx-3 lg:flex-col lg:gap-1">
      <button type="button" data-category-filter="" class="filter-choice is-active">Catálogo completo</button>
      {filters.map((filter) => (
        <button type="button" data-category-filter={filter.subcategorias.join('|')} class="filter-choice">{filter.label}</button>
      ))}
    </div>
  </div>
</aside>

<style>
  .filter-choice {
    width: 100%;
    border: 1px solid transparent;
    padding: 0.6rem 0.75rem;
    text-align: left;
    font-size: 0.85rem;
    color: rgb(75 85 99);
    transition: 180ms ease;
  }

  .filter-choice:hover,
  .filter-choice.is-active {
    border-color: rgb(17 17 17 / 0.12);
    background: white;
    color: #111;
  }

  .filter-choice.is-active {
    font-weight: 650;
    box-shadow: inset 3px 0 #111;
  }

  .filter-choice:focus-visible {
    outline: 2px solid #111;
    outline-offset: 1px;
  }

  @media (max-width: 1023px) {
    #catalog-filters {
      margin-bottom: 1.5rem;
    }

    #catalog-filters.is-open {
      display: block;
    }

    .filter-choice {
      width: auto;
      border-color: rgb(17 17 17 / 0.12);
      background: white;
    }
  }
</style>
