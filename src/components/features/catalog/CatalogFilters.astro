---
import { getCatalogFilters } from '@config/productTaxonomy';

const filters = getCatalogFilters();
---

<aside id="catalog-filters" class="hidden border border-gray-200 bg-[#faf9f7] lg:sticky lg:top-28 lg:block">
  <div class="flex items-center justify-between border-b border-gray-200 px-5 py-4">
    <div>
      <p class="text-[9px] uppercase tracking-[0.26em] text-gray-400">Catálogo T3R</p>
      <h2 class="mt-1 text-base font-bold">Filtrar productos</h2>
    </div>
    <button id="sidebar-clear" type="button" style="display: none;" class="inline-flex items-center gap-1 rounded-full border border-gray-300 px-2 py-0.5 text-[10px] font-medium text-gray-500 transition-colors hover:border-black hover:bg-black hover:text-white">
      <svg class="h-2 w-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" d="m6 6 12 12M18 6 6 18"/></svg>
      Limpiar
    </button>
  </div>

  <div class="p-5">
    <p class="mb-3 text-[10px] font-semibold uppercase tracking-[0.2em] text-gray-400">Categorías</p>
    <div class="flex flex-wrap gap-2 lg:flex-col lg:gap-1">
      <button type="button" data-category-filter="" class="filter-choice is-active">Catálogo completo</button>
      {filters.map((filter) => (
        <button type="button" data-category-filter={filter.subcategorias.join('|')} class="filter-choice">{filter.label}</button>
      ))}
    </div>
  </div>
</aside>

<style>
  .filter-choice {
    width: 100%;
    border: 1px solid transparent;
    padding: 0.6rem 0.75rem;
    text-align: left;
    font-size: 0.78rem;
    color: rgb(75 85 99);
    transition: 180ms ease;
  }

  .filter-choice:hover,
  .filter-choice.is-active {
    border-color: rgb(17 17 17 / 0.12);
    background: white;
    color: #111;
  }

  .filter-choice.is-active {
    font-weight: 650;
    box-shadow: inset 3px 0 #111;
  }

  @media (max-width: 1023px) {
    #catalog-filters {
      margin-bottom: 1.5rem;
    }

    #catalog-filters.is-open {
      display: block;
    }

    .filter-choice {
      width: auto;
    }
  }
</style>
