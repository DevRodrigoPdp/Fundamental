---
import { cld } from '@lib/cloudinary/url';
import type { HomeBanner } from '@config/homeBanners';

interface Props {
  banner: HomeBanner;
}

const { banner } = Astro.props;
---

<section class="relative overflow-hidden group" style={`height: ${banner.height};`}>
  <a href={banner.href} class="absolute inset-0 z-20"></a>
  <img
    src={cld(banner.image, { width: 1920 })}
    alt={banner.alt}
    class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
    style={banner.imageStyle}
    loading="lazy"
    decoding="async"
  />
  <div class={`absolute inset-0 ${banner.overlayClass}`}></div>
  <div class="pointer-events-none absolute inset-0 z-30 flex flex-col items-center justify-center px-8 text-center">
    <img data-reveal src={banner.logo} alt={banner.logoAlt} class={banner.logoClass} />
    {banner.tagline && (
      <p data-reveal data-delay="1" class="text-xs text-white/75 tracking-[0.35em] uppercase mb-8">{banner.tagline}</p>
    )}
    <a data-reveal data-delay={banner.tagline ? '2' : '1'} href={banner.href}
      class="paint-fill-button pointer-events-auto border border-white text-white text-xs font-semibold px-10 py-4 tracking-[0.2em] uppercase cursor-pointer relative z-30">
      <span class="relative z-10">{banner.cta}</span>
    </a>
  </div>
</section>
