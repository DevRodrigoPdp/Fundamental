---
import { cld } from '@lib/cloudinary/url';
import type { NewProduct } from '@lib/services/home';

interface Props {
  product: NewProduct;
  index: number;
}

const { product: p, index } = Astro.props;
---

<a href={`/catalogo/${p.ref}`} data-reveal data-delay={String((index % 3) + 1)} class="group cursor-pointer snap-start shrink-0 block" style="width: clamp(220px, 68vw, 360px);">
  <div class="relative overflow-hidden bg-white mb-5" style="aspect-ratio: 4/3;">
    <span class="absolute top-4 left-4 z-10 bg-white text-[#1A100C] text-xs font-bold px-3 py-1.5 tracking-[0.15em] uppercase">New</span>
    <img src={p.imagen ? cld(p.imagen, { width: 500 }) : '/logo_t3r.png'} alt={p.name}
      class={p.imagen ? "absolute inset-0 w-full h-full object-contain p-6 transition-transform duration-500 group-hover:scale-[1.02]" : "absolute inset-0 m-auto h-14 opacity-20"}
      loading="lazy"
      onerror="this.onerror=null; this.src='/logo_t3r.png'; this.className='absolute inset-0 m-auto h-14 opacity-20';" />
  </div>
  <p class="text-xs text-gray-400 tracking-[0.25em] uppercase mb-1.5">{p.category}</p>
  <h3 class="line-clamp-2 break-words font-semibold text-xl text-gray-900 mb-1.5">{p.name}</h3>
  <p class="text-base text-gray-400">Consulta disponibilidad</p>
</a>
