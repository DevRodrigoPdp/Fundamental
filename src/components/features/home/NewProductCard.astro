---
import { cld } from '@lib/cloudinary/url';
import type { NewProduct } from '@lib/services/home';

interface Props {
  product: NewProduct;
  index: number;
}

const { product: p, index } = Astro.props;
---

<a
  href={`/catalogo/${p.ref}`}
  data-reveal
  data-delay={String((index % 3) + 1)}
  class="group block w-[66%] shrink-0 snap-start cursor-pointer sm:w-[calc((100%-2rem)/3)] lg:w-[calc((100%-4rem)/5)]"
>
  <div class="relative mb-4 overflow-hidden bg-[#F2F2F2]" style="aspect-ratio: 4/5;">
    <span class="absolute left-3 top-3 z-10 bg-white px-2.5 py-1 text-[11px] font-bold uppercase tracking-[0.15em] text-[#1A100C]">New</span>
    <img
      src={p.imagen ? cld(p.imagen, { width: 500 }) : '/logo_t3r.png'}
      alt={p.name}
      class={p.imagen ? 'absolute inset-0 h-full w-full object-contain p-6 mix-blend-multiply transition-transform duration-500 group-hover:scale-[1.04]' : 'absolute inset-0 m-auto h-14 opacity-20'}
      loading="lazy"
      onerror="this.onerror=null; this.src='/logo_t3r.png'; this.className='absolute inset-0 m-auto h-14 opacity-20';"
    />
  </div>
  <p class="mb-1 text-xs uppercase tracking-[0.2em] text-gray-500">{p.category}</p>
  <h3 class="mb-1 line-clamp-2 break-words text-base font-semibold text-gray-900 transition-colors group-hover:text-[#8B6B3F]">{p.name}</h3>
  <p class="text-sm text-gray-500">Consulta disponibilidad</p>
</a>
