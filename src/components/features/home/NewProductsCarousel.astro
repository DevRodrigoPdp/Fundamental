---
import NewProductCard from './NewProductCard.astro';
import type { NewProduct } from '@lib/services/home';

interface Props {
  products: NewProduct[];
}

const { products } = Astro.props;
---

<section id="productos" class="border-b border-gray-100 bg-white px-5 py-16 md:px-12">
  <div class="mx-auto max-w-7xl">
    <div class="mb-8 flex flex-col items-center justify-center gap-3 text-center sm:flex-row sm:items-baseline sm:gap-4">
      <span class="bg-[#C4A072] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#1A100C]">New</span>
      <h2 class="text-xl font-bold uppercase tracking-tight">Novedades T3R · Gama 2026</h2>
    </div>

    {products.length > 0 ? (
      <div
        id="novedades-carousel"
        class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2"
        style="scrollbar-width: none;"
      >
        {products.map((product, index) => <NewProductCard product={product} index={index} />)}
      </div>
    ) : (
      <p class="mb-10 text-center text-sm text-gray-500">Catálogo en preparación — vuelve pronto.</p>
    )}

    <div class="relative mt-8 flex items-center justify-center">
      <a href="/catalogo"
        class="paint-fill-button paint-fill-button--dark cursor-pointer border border-[#1A100C] px-8 py-3.5 text-xs font-semibold uppercase tracking-[0.2em] text-[#1A100C]">
        <span class="relative z-10">Ver catálogo completo</span>
      </a>
      {products.length > 5 && (
        <div class="absolute right-0 hidden items-center gap-2 md:flex">
          <button id="carousel-prev" type="button" aria-label="Anterior"
            class="flex h-9 w-9 cursor-pointer items-center justify-center border border-gray-200 transition-colors hover:border-[#1A100C]">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button id="carousel-next" type="button" aria-label="Siguiente"
            class="flex h-9 w-9 cursor-pointer items-center justify-center border border-gray-200 transition-colors hover:border-[#1A100C]">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      )}
    </div>
  </div>
</section>

<script>import '@scripts/home/carousel';</script>
