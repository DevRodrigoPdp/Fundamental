---
import { formatSpecKey, formatSpecValue } from '@lib/utils/format';

interface Props {
  specs: Record<string, unknown>;
}

const { specs } = Astro.props;
---

<div class="border-t border-gray-200 pt-8 mb-10">
  <p class="text-sm text-gray-400 tracking-[0.2em] uppercase mb-5">Especificaciones</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    {Object.entries(specs).map(([k, v]) => (
      <div class:list={[formatSpecValue(v).length > 30 && 'sm:col-span-2']}>
        <p class="text-gray-400 text-[11px] uppercase tracking-widest mb-1">{formatSpecKey(k)}</p>
        <p class="text-black text-sm font-medium">{formatSpecValue(v)}</p>
      </div>
    ))}
  </div>
</div>
