---
import RelatedProductCard from './RelatedProductCard.astro';
import type { ProductCardData } from '@app-types/product';

interface Props {
  title: string;
  products: ProductCardData[];
}

const { title, products } = Astro.props;
---

<section class="bg-[#fafafa] px-5 md:px-16 py-20 border-t border-gray-100">
  <p class="text-sm text-[#6B8CAE] tracking-[0.25em] uppercase mb-3">También te puede interesar</p>
  <h2 class="text-2xl font-bold mb-10">{title}</h2>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    {products.map((product) => <RelatedProductCard product={product} />)}
  </div>
</section>
