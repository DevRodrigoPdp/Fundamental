---
import { SITE } from '@config/site';

interface Props {
  class?: string;
}

const { class: className = 'transition-colors hover:text-[#6B8CAE]' } = Astro.props;
---

<a href={SITE.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram de Fundamental" class={className}>
  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".75" fill="currentColor" stroke="none"/></svg>
</a>
